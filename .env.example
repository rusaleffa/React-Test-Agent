# .env.example
# Скопируйте этот файл в .env и заполните своими значениями


# ⚙️  Настройки агента
# Креативность AI (0.1 - консервативно, 1.0 - креативно)
AGENT_TEMPERATURE=0.3

# Фреймворк тестирования
TEST_FRAMEWORK=jest

# Библиотека тестирования
TESTING_LIBRARY=react-testing-library

# Количество попыток при ошибках
MAX_RETRIES=3

# Генерировать моки автоматически
GENERATE_MOCKS=true

# Включать оценку покрытия
ENABLE_COVERAGE=true

# 🐛 Настройки отладки
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# Расширенное логирование
DEBUG_MODE=false

# 💾 Настройки памяти
# Время жизни кэша в минутах
MEMORY_CACHE_TTL=60

# Максимальное количество записей в памяти
MAX_MEMORY_ENTRIES=1000